<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.5.7</version>
        <relativePath/>
    </parent>

    <groupId>br.sd.barragem</groupId>
    <artifactId>barragem-alarme</artifactId>
    <version>1.0.0</version>
    <packaging>pom</packaging>

    <name>TP1 - Alarme de barragem de rejeito</name>

    <modules>
        <module>compartilhado/contrato-grpc</module>
        <module>compartilhado/comum</module>
        <module>campo/broker-mqtt</module>
        <module>campo/sensores</module>
        <module>campo/atuadores</module>
        <module>middleware/controlador</module>
        <module>clientes/cliente-core</module>
        <module>clientes/cliente-cli</module>
        <module>clientes/painel-web</module>
    </modules>

    <properties>
        <java.version>21</java.version>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <grpc.version>1.68.1</grpc.version>
        <protobuf.version>3.25.5</protobuf.version>
        <paho.version>1.2.5</paho.version>
        <moquette.version>0.17</moquette.version>
    </properties>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>io.grpc</groupId>
                <artifactId>grpc-bom</artifactId>
                <version>${grpc.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
            <dependency>
                <groupId>com.google.protobuf</groupId>
                <artifactId>protobuf-java</artifactId>
                <version>${protobuf.version}</version>
            </dependency>
            <dependency>
                <groupId>org.eclipse.paho</groupId>
                <artifactId>org.eclipse.paho.client.mqttv3</artifactId>
                <version>${paho.version}</version>
            </dependency>
            <dependency>
                <groupId>io.moquette</groupId>
                <artifactId>moquette-broker</artifactId>
                <version>${moquette.version}</version>
            </dependency>
            <dependency>
                <groupId>br.sd.barragem</groupId>
                <artifactId>contrato-grpc</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>br.sd.barragem</groupId>
                <artifactId>comum</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>br.sd.barragem</groupId>
                <artifactId>cliente-core</artifactId>
                <version>${project.version}</version>
            </dependency>
        </dependencies>
    </dependencyManagement>
</project>
