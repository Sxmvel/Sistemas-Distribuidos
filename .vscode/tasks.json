{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "TP1: compilar",
            "type": "process",
            "command": "powershell",
            "args": ["-NoProfile", "-ExecutionPolicy", "Bypass", "-File", "${workspaceFolder}/Trabalho-Pratico-1/scripts/compilar.ps1"],
            "group": "build",
            "problemMatcher": [],
            "presentation": { "reveal": "always", "panel": "shared", "clear": true }
        },
        {
            "label": "TP1: iniciar tudo (janelas)",
            "type": "process",
            "command": "powershell",
